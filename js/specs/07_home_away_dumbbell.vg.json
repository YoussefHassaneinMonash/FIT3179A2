{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: each club's home win % vs away win %, 2012-2026, sorted by the size of the gap.",
  "data": {
    "url": "data/home_away.csv"
  },
  "width": "container",
  "height": 460,
  "transform": [
    {
      "pivot": "side",
      "value": "win_pct",
      "groupby": [
        "team"
      ]
    },
    {
      "calculate": "datum.home - datum.away",
      "as": "gap"
    },
    {
      "calculate": "'+' + format(datum.gap, '.0f')",
      "as": "gap_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "team",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "gap",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelPadding": 6,
        "grid": true,
        "gridDash": [
          2,
          3
        ],
        "labelExpr": "datum.label == 'Greater Western Sydney' ? 'GWS Giants' : datum.label",
        "labelFontSize": 14,
        "labelColor": "#1c1b19"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#bdb8ab",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "away",
          "type": "quantitative",
          "title": "Games won (%)",
          "scale": {
            "domain": [
              20,
              85
            ]
          },
          "axis": {
            "gridDash": [
              2,
              3
            ],
            "domain": false,
            "values": [
              20,
              30,
              40,
              50,
              60,
              70,
              80
            ],
            "labelFontSize": 13
          }
        },
        "x2": {
          "field": "home"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "home",
            "away"
          ],
          "as": [
            "side",
            "pct"
          ]
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110,
        "opacity": 1,
        "stroke": "#fffdf8",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "pct",
          "type": "quantitative"
        },
        "color": {
          "field": "side",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "home",
              "away"
            ],
            "range": [
              "#1f5fa8",
              "#eb6834"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "labelExpr": "datum.label == 'home' ? 'Win % at home' : 'Win % away'",
            "labelFontSize": 14
          }
        },
        "tooltip": [
          {
            "field": "team",
            "title": "Club"
          },
          {
            "field": "home",
            "title": "Home win %"
          },
          {
            "field": "away",
            "title": "Away win %"
          },
          {
            "field": "gap",
            "title": "Gap (points)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "color": "#55524b",
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "home",
          "type": "quantitative"
        },
        "text": {
          "field": "gap_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.team == 'Geelong'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#c8102e"
      },
      "encoding": {
        "x": {
          "field": "away",
          "type": "quantitative"
        },
        "text": {
          "value": "Kardinia Park fortress: 82% at home"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.team == 'Collingwood'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -12,
        "fontSize": 13,
        "fontStyle": "italic",
        "color": "#c8102e"
      },
      "encoding": {
        "x": {
          "field": "away",
          "type": "quantitative"
        },
        "text": {
          "value": "No home advantage: 58% home and away"
        }
      }
    }
  ]
}
