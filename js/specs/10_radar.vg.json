{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Radar chart (Vega): one club's per-game averages in a season as an index of the league average (100 = average). Club and season are chosen by the reader.",
  "width": 320,
  "height": 320,
  "padding": {
    "top": 44,
    "bottom": 60,
    "left": 120,
    "right": 120
  },
  "autosize": {
    "type": "none"
  },
  "signals": [
    {
      "name": "radius",
      "update": "width / 2"
    },
    {
      "name": "focusTeam",
      "value": "Brisbane Lions",
      "bind": {
        "input": "select",
        "name": "Club ",
        "options": [
          "Adelaide",
          "Brisbane Lions",
          "Carlton",
          "Collingwood",
          "Essendon",
          "Fremantle",
          "Geelong",
          "Gold Coast",
          "Greater Western Sydney",
          "Hawthorn",
          "Melbourne",
          "North Melbourne",
          "Port Adelaide",
          "Richmond",
          "St Kilda",
          "Sydney",
          "West Coast",
          "Western Bulldogs"
        ]
      }
    },
    {
      "name": "focusYear",
      "value": 2026,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2026,
        "step": 1,
        "name": "Season "
      }
    }
  ],
  "data": [
    {
      "name": "profiles",
      "url": "data/team_profiles.csv",
      "format": {
        "type": "csv",
        "parse": "auto"
      },
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year == focusYear"
        },
        {
          "type": "fold",
          "fields": [
            "inside_50s",
            "clearances",
            "contested_possessions",
            "tackles",
            "marks_inside_50",
            "goals"
          ],
          "as": [
            "stat",
            "value"
          ]
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "stat"
          ],
          "ops": [
            "mean"
          ],
          "fields": [
            "value"
          ],
          "as": [
            "league_avg"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.team == focusTeam"
        },
        {
          "type": "formula",
          "as": "index",
          "expr": "100 * datum.value / datum.league_avg"
        },
        {
          "type": "formula",
          "as": "label",
          "expr": "{'inside_50s': 'Inside 50s', 'clearances': 'Clearances', 'contested_possessions': 'Contested poss.', 'tackles': 'Tackles', 'marks_inside_50': 'Marks inside 50', 'goals': 'Goals'}[datum.stat]"
        }
      ]
    },
    {
      "name": "rings",
      "values": [
        {
          "r": 75
        },
        {
          "r": 125
        }
      ]
    },
    {
      "name": "ringLabels",
      "values": [
        {
          "r": 50,
          "t": "50"
        },
        {
          "r": 75,
          "t": "75"
        },
        {
          "r": 100,
          "t": "100"
        },
        {
          "r": 125,
          "t": "125"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "angular",
      "type": "point",
      "range": {
        "signal": "[-PI, PI]"
      },
      "padding": 0.5,
      "domain": [
        "inside_50s",
        "clearances",
        "contested_possessions",
        "tackles",
        "marks_inside_50",
        "goals"
      ]
    },
    {
      "name": "radial",
      "type": "linear",
      "range": {
        "signal": "[0, radius]"
      },
      "zero": false,
      "nice": false,
      "clamp": true,
      "domain": [
        50,
        140
      ]
    },
    {
      "name": "key",
      "type": "ordinal",
      "domain": {
        "signal": "[focusTeam == 'Greater Western Sydney' ? 'GWS Giants' : focusTeam, 'League average (100)']"
      },
      "range": [
        "#c8102e",
        "#8a867c"
      ]
    }
  ],
  "legends": [
    {
      "fill": "key",
      "orient": "none",
      "legendX": {
        "signal": "-radius - 115"
      },
      "legendY": {
        "signal": "-radius - 40"
      },
      "direction": "vertical",
      "symbolType": "square",
      "symbolSize": 140,
      "labelFontSize": 13,
      "labelFont": "'Source Sans 3', sans-serif",
      "labelColor": "#1c1b19"
    }
  ],
  "encode": {
    "enter": {
      "x": {
        "signal": "radius"
      },
      "y": {
        "signal": "radius"
      }
    }
  },
  "marks": [
    {
      "type": "group",
      "name": "ringGroup",
      "from": {
        "facet": {
          "data": "rings",
          "name": "ring",
          "groupby": "r"
        }
      },
      "marks": [
        {
          "type": "line",
          "from": {
            "data": "profiles"
          },
          "encode": {
            "update": {
              "interpolate": {
                "value": "linear-closed"
              },
              "x": {
                "signal": "scale('radial', parent.r) * cos(scale('angular', datum.stat))"
              },
              "y": {
                "signal": "scale('radial', parent.r) * sin(scale('angular', datum.stat))"
              },
              "stroke": {
                "value": "#ddd8cc"
              },
              "strokeWidth": {
                "value": 1
              }
            }
          }
        }
      ]
    },
    {
      "type": "rule",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "update": {
          "x": {
            "value": 0
          },
          "y": {
            "value": 0
          },
          "x2": {
            "signal": "radius * cos(scale('angular', datum.stat))"
          },
          "y2": {
            "signal": "radius * sin(scale('angular', datum.stat))"
          },
          "stroke": {
            "value": "#ddd8cc"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "line",
      "description": "League average: index 100 on every spoke.",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "update": {
          "interpolate": {
            "value": "linear-closed"
          },
          "x": {
            "signal": "scale('radial', 100) * cos(scale('angular', datum.stat))"
          },
          "y": {
            "signal": "scale('radial', 100) * sin(scale('angular', datum.stat))"
          },
          "stroke": {
            "value": "#8a867c"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "strokeDash": {
            "value": [
              5,
              4
            ]
          },
          "fill": {
            "value": "#8a867c"
          },
          "fillOpacity": {
            "value": 0.12
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "ringLabels"
      },
      "encode": {
        "update": {
          "x": {
            "value": 4
          },
          "y": {
            "signal": "-scale('radial', datum.r)"
          },
          "text": {
            "field": "t"
          },
          "baseline": {
            "value": "middle"
          },
          "font": {
            "value": "'Source Sans 3', sans-serif"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#55524b"
          },
          "stroke": {
            "value": "#fffdf8"
          },
          "strokeWidth": {
            "value": 3
          }
        }
      }
    },
    {
      "type": "line",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "update": {
          "interpolate": {
            "value": "linear-closed"
          },
          "x": {
            "signal": "scale('radial', datum.index) * cos(scale('angular', datum.stat))"
          },
          "y": {
            "signal": "scale('radial', datum.index) * sin(scale('angular', datum.stat))"
          },
          "stroke": {
            "value": "#c8102e"
          },
          "strokeWidth": {
            "value": 2.5
          },
          "fill": {
            "value": "#c8102e"
          },
          "fillOpacity": {
            "value": 0.15
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('radial', datum.index) * cos(scale('angular', datum.stat))"
          },
          "y": {
            "signal": "scale('radial', datum.index) * sin(scale('angular', datum.stat))"
          },
          "size": {
            "value": 70
          },
          "fill": {
            "value": "#c8102e"
          },
          "stroke": {
            "value": "#fffdf8"
          },
          "strokeWidth": {
            "value": 1.5
          },
          "tooltip": {
            "signal": "{'Club': focusTeam, 'Season': focusYear, 'Stat': datum.label, 'Club per game': format(datum.value, '.1f'), 'League average': format(datum.league_avg, '.1f'), 'Index (100 = average)': format(datum.index, '.0f')}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "profiles"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(radius + 14) * cos(scale('angular', datum.stat))"
          },
          "y": {
            "signal": "(radius + 14) * sin(scale('angular', datum.stat))"
          },
          "text": {
            "signal": "[datum.label, format(datum.index, '.0f')]"
          },
          "align": {
            "signal": "abs(cos(scale('angular', datum.stat))) < 0.2 ? 'center' : (cos(scale('angular', datum.stat)) > 0 ? 'left' : 'right')"
          },
          "baseline": {
            "signal": "sin(scale('angular', datum.stat)) > 0.5 ? 'top' : (sin(scale('angular', datum.stat)) < -0.5 ? 'bottom' : 'middle')"
          },
          "font": {
            "value": "'Source Sans 3', sans-serif"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": 600
          },
          "fill": {
            "value": "#1c1b19"
          },
          "lineHeight": {
            "value": 16
          }
        }
      }
    }
  ]
}
