{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline plot: the distribution (smoothed) of winning margins in each season 2012-2026.",
  "data": {"url": "data/margins.csv"},
  "transform": [
    {"density": "margin", "groupby": ["year"], "extent": [0, 150], "steps": 120, "bandwidth": 6}
  ],
  "facet": {
    "row": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "header": {"labelAngle": 0, "labelAlign": "right", "labelPadding": 6, "labelFontSize": 12, "labelColor": "#55524b"}
    }
  },
  "spacing": 0,
  "bounds": "flush",
  "spec": {
    "width": 560,
    "height": 22,
    "mark": {"type": "area", "interpolate": "monotone", "fillOpacity": 0.85, "stroke": "#fffdf8", "strokeWidth": 1},
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "title": "Winning margin (points)",
        "scale": {"domain": [0, 150]},
        "axis": {"grid": false, "values": [0, 25, 50, 75, 100, 125, 150]}
      },
      "y": {
        "field": "density",
        "type": "quantitative",
        "scale": {"range": [22, -24]},
        "axis": null
      },
      "fill": {
        "field": "year",
        "type": "ordinal",
        "legend": null,
        "scale": {"scheme": "blues"}
      }
    }
  },
  "config": {"view": {"stroke": null}}
}
